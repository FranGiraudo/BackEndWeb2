generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  comprador
  vendedor
}

enum NotificationType {
  NEW_INQUIRY
  PRICE_DROP
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

// MODELOS
model User {
  id           Int       @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String    @unique
  password     String
  avatarUrl    String?
  role         Role      @default(comprador)
  createdAt    DateTime  @default(now())

  // Relaciones
  cars         Car[]     @relation("SellerCars")
  buyerInquiries  Inquiry[]  @relation("BuyerInquiries")
  sellerInquiries Inquiry[]  @relation("SellerInquiries")
  favorites    Favorite[]
  replies      Reply[]
  reviewsGiven      Review[]    @relation("Reviewer")
  reviewsReceived   Review[]    @relation("Vendor")
  reportsMade       Report[]    @relation("Reporter")
  searchHistories   SearchHistory[]
  aiRecommendations AiRecommendation[]
  bids              Bid[]
  notifications     Notification[]

  @@map("users")
}

model Car {
  id           Int      @id @default(autoincrement())
  brand        String
  model        String
  year         Int
  price        Float
  km           Int
  bodyType     String   // Guardamos el string para no romper compatibilidad con el frontend
  location     String
  transmission String
  fuel         String
  description  String?  @db.Text
  color        String?
  doors        Int?
  engine       String?
  status       String   @default("Disponible") // Disponible, Reservado, Vendido
  
  // Ubicacion Geografica
  locationName String?
  latitude     Float?
  longitude    Float?

  // Campos de análisis IA
  aiStatus     String?  // "Excelente estado" | "Buen estado" | "Estado regular" | "Requiere reparación"
  aiDamages    String?
  aiPriceMin   Float?
  aiPriceMax   Float?
  aiScore      Int?     // Puntaje de oportunidad del 1 al 100

  // Analytics embebidos (desnormalizados para consulta rápida)
  viewCount    Int      @default(0)
  contacts     Int      @default(0)

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  sellerId     Int
  seller       User     @relation("SellerCars", fields: [sellerId], references: [id], onDelete: Cascade)
  images       Image[]
  inquiries    Inquiry[]
  favorites    Favorite[]
  reports      Report[]
  auction      Auction?
  priceHistories PriceHistory[]
  viewLogs     CarViewLog[]

  @@map("cars")
}

model CarViewLog {
  id        Int      @id @default(autoincrement())
  carId     Int
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  views     Int      @default(0)

  @@unique([carId, date])
  @@map("car_view_logs")
}

model Image {
  id        Int      @id @default(autoincrement())
  url       String
  filename  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relaciones
  carId     Int
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("images")
}

model Inquiry {
  id            Int      @id @default(autoincrement())
  text          String   @db.Text
  senderName    String
  markedAsReadBy String?  // 'vendedor' | 'comprador'
  status        String   @default("Nuevo") // Nuevo, En Negociacion, Vendido, Descartado
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  carId         Int
  car           Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  
  senderId      Int
  sender        User     @relation("BuyerInquiries", fields: [senderId], references: [id], onDelete: Cascade)
  
  sellerId      Int
  seller        User     @relation("SellerInquiries", fields: [sellerId], references: [id], onDelete: Cascade)
  
  replies       Reply[]

  @@map("inquiries")
}

model Reply {
  id          Int      @id @default(autoincrement())
  text        String   @db.Text
  senderName  String
  senderRole  String   // 'vendedor' | 'comprador'
  createdAt   DateTime @default(now())

  // Relaciones
  inquiryId   Int
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  
  senderId    Int
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("replies")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // Relaciones
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  carId     Int
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId]) // Un usuario no puede tener el mismo auto dos veces como favorito
  @@map("favorites")
}

// Nuevos Modelos: Calificaciones y Reportes
model Review {
  id         Int      @id @default(autoincrement())
  reviewerId Int
  vendorId   Int
  score      Int      // 1 a 5
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  vendor     User     @relation("Vendor", fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, vendorId])
  @@map("reviews")
}

model Report {
  id          Int          @id @default(autoincrement())
  reporterId  Int
  carId       Int
  reason      String
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  reporter    User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  car         Car          @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model SearchHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  queryText String
  filters   Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_histories")
}

model AiRecommendation {
  id        Int      @id @default(autoincrement())
  userId    Int
  carIds    Int[]
  score     Int
  reason    String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_recommendations")
}

model Auction {
  id            Int      @id @default(autoincrement())
  carId         Int      @unique
  startingPrice Float
  currentPrice  Float
  endsAt        DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  car           Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  bids          Bid[]

  @@map("auctions")
}

model Bid {
  id        Int      @id @default(autoincrement())
  auctionId Int
  bidderId  Int
  amount    Float
  createdAt DateTime @default(now())

  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@map("bids")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  carId     Int
  oldPrice  Float
  newPrice  Float
  changedAt DateTime @default(now())

  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("price_histories")
}
